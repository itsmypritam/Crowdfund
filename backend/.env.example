PORT=3001
CONTRACT_ID=CCP3FESW4PWZ6ZEQZI2B4GDBXY2KM3UESU4J4RZB53AUV4BUIFML72L5
HORIZON_URL=https://horizon-testnet.stellar.org
RPC_URL=https://soroban-testnet.stellar.org

# ── Persistence ──────────────────────────────────────────────────
# SQLite database file (survives restarts; use a persistent disk on
# your host for full durability across redeploys)
DATA_FILE=./data/db.sqlite
# Legacy JSON file (backend/data/db.json) is auto-imported once on first boot

# ── Security ─────────────────────────────────────────────────────
# Comma-separated list of allowed CORS origins (empty = allow all)
CORS_ORIGINS=https://warriorpinto-6k1ikg.stormkit.dev,http://localhost:4321
# Shared secret required to write the global contract id via x-admin-key header
ADMIN_KEY=
# Disable /api rate limiting (set to 1 only for tests)
# DISABLE_RATE_LIMIT=0

# ── Ops ──────────────────────────────────────────────────────────
LOG_LEVEL=info
# Donation tx verification against Horizon (disable only for tests)
# VERIFY_DONATIONS=1
