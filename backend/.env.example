PORT=3001
CONTRACT_ID=CDL7NSGKCSDYRYZDNT3LLE4CDVQKRIISID5MP7G2G5OHTFW4SQYKSG4O
HORIZON_URL=https://horizon-testnet.stellar.org
RPC_URL=https://soroban-testnet.stellar.org

# ── Persistence ──────────────────────────────────────────────────
# SQLite database file (survives restarts; use a persistent disk on
# your host for full durability across redeploys)
DATA_FILE=./data/db.sqlite
# Legacy JSON file (backend/data/db.json) is auto-imported once on first boot

# ── Security ─────────────────────────────────────────────────────
# Comma-separated list of allowed CORS origins (empty = allow all)
CORS_ORIGINS=https://warriorpinto-6k1ikg.stormkit.dev,http://localhost:4321
# Shared secret required to write the global contract id via x-admin-key header
ADMIN_KEY=
# Disable /api rate limiting (set to 1 only for tests)
# DISABLE_RATE_LIMIT=0

# ── Ops ──────────────────────────────────────────────────────────
LOG_LEVEL=info
# Donation tx verification against Horizon (disable only for tests)
# VERIFY_DONATIONS=1

# ── Notifications queue (BullMQ) ─────────────────────────────────
# Redis connection string used by the notification job queue.
# Leave empty to insert notifications synchronously (no Redis required).
#
# Upstash Redis: BullMQ uses the Redis wire protocol, not the REST API.
# The Upstash REST token doubles as the Redis password; TLS port is 6380.
#   REDIS_URL=rediss://default:<UPSTASH_REST_TOKEN>@<your-db>.upstash.io:6380
#
# REDIS_URL=redis://localhost:6379
